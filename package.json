{
  "name": "weeve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "node prisma/seed.js",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "docker:dev": "docker-compose up --build",
    "android:release:bundle": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:release:bundle:remote": "CAPACITOR_SERVER_URL=\"https://tryweeve.com\" CAPACITOR_SERVER_CLEARTEXT=false npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:staging:bundle": "CAPACITOR_SERVER_URL=\"https://staging.tryweeve.com\" CAPACITOR_SERVER_CLEARTEXT=false npm run build && npx cap sync android && cd android && ./gradlew bundleStaging",
    "android:dev:sync": "CAPACITOR_SERVER_URL=\"http://192.168.0.230:3000\" CAPACITOR_SERVER_CLEARTEXT=true npx cap sync android && npx cap open android",
    "android:emulator:sync": "CAPACITOR_SERVER_URL=\"http://10.0.2.2:3000\" CAPACITOR_SERVER_CLEARTEXT=true npx cap sync android && npx cap open android",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.933.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/media": "^8.0.1",
    "@capacitor-community/video-recorder": "^7.5.0",
    "@capacitor-firebase/crashlytics": "^8.0.1",
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor/action-sheet": "^7.0.2",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/dialog": "^7.0.2",
    "@capacitor/filesystem": "^7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^7.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.84.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "capacitor-voice-recorder": "^7.0.6",
    "fabric": "^6.5.1",
    "firebase": "^12.6.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.554.0",
    "mailgun.js": "^12.4.1",
    "micro": "^10.0.1",
    "multer": "^2.0.2",
    "next": "16.0.7",
    "next-auth": "^4.24.13",
    "prisma": "^6.19.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-easy-crop": "^5.5.6",
    "react-image-crop": "^11.0.10",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fabric": "^5.3.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^2.35.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^4.0.0",
    "vitest": "^1.0.0"
  }
}
